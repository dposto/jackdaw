{
    "app-id": "io.github.dposto.Jackdaw",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.8",
    "sdk": "org.kde.Sdk",
    "base": "com.riverbankcomputing.PyQt.BaseApp",
    "base-version": "6.8",
    "command": "jackdaw",
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--filesystem=home",
        "--env=QTWEBENGINEPROCESS_PATH=/app/bin/QtWebEngineProcess"
    ],
    "cleanup-commands": [
        "/app/cleanup-BaseApp.sh"
    ],
    "modules": [
        {
            "name": "enchant",
            "buildsystem": "autotools",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/AbiWord/enchant/releases/download/v2.8.2/enchant-2.8.2.tar.gz",
                    "sha256": "8f19535adb5577b83b00e02f330fe9b9eb40dd21f19e2899636fc4d3a7696375"
                }
            ]
        },
        {
            "name": "pyenchant",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --no-index --prefix=/app --no-build-isolation ."
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://files.pythonhosted.org/packages/source/p/pyenchant/pyenchant-3.3.0.tar.gz",
                    "sha256": "825288246b5debc9436f91967650974ef0d5636458502619e322c476f1283891"
                }
            ]
        },
        {
            "name": "jackdaw",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm755 jackdaw.py /app/bin/jackdaw",
                "install -Dm644 icons/jackdaw-256.png /app/share/icons/hicolor/256x256/apps/io.github.dposto.Jackdaw.png",
                "install -Dm644 icons/jackdaw-128.png /app/share/icons/hicolor/128x128/apps/io.github.dposto.Jackdaw.png",
                "install -Dm644 io.github.dposto.Jackdaw.desktop /app/share/applications/io.github.dposto.Jackdaw.desktop",
                "install -Dm644 io.github.dposto.Jackdaw.metainfo.xml /app/share/metainfo/io.github.dposto.Jackdaw.metainfo.xml"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/dposto/jackdaw.git",
                    "branch": "main"
                }
            ]
        }
    ]
}
